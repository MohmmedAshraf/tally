{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RowData"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "matched": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroupSummary"
      }
    },
    "aggregates": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "facets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Facet"
      }
    }
  },
  "required": [
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "RowData": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "GroupSummary": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {},
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "aggregates": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "key",
        "value",
        "count",
        "aggregates"
      ],
      "additionalProperties": false
    },
    "Facet": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "histogram"
            },
            "min": {},
            "max": {},
            "bins": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {},
                  "end": {},
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end",
                  "count"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "min",
            "max",
            "bins"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "terms"
            },
            "terms": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {},
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "distinct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "terms",
            "distinct"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
