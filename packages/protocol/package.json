{
  "name": "tally-protocol",
  "version": "0.0.0",
  "description": "Tally Query Protocol: wire schemas, request validation, JSON Schema and the adapter conformance suite.",
  "license": "MIT",
  "author": "Mohamed Ashraf <cupo.ashraf@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohmmedAshraf/tally.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/MohmmedAshraf/tally",
  "bugs": "https://github.com/MohmmedAshraf/tally/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/query-request.json": "./schemas/query-request.json",
    "./schemas/query-response.json": "./schemas/query-response.json",
    "./schemas/mutation-request.json": "./schemas/mutation-request.json",
    "./schemas/mutation-result.json": "./schemas/mutation-result.json",
    "./schemas/row-patch.json": "./schemas/row-patch.json",
    "./schemas/schema-response.json": "./schemas/schema-response.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/emit-schemas.ts",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --coverage.enabled=false",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "size": "size-limit",
    "schemas": "node scripts/emit-schemas.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "12 kB",
      "ignore": [
        "tally-core",
        "zod"
      ]
    }
  ],
  "dependencies": {
    "tally-core": "workspace:*",
    "zod": "catalog:"
  }
}
