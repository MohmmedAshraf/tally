{
  "name": "tally-server",
  "version": "0.0.0",
  "description": "Kysely adapter and Fetch handler serving the Tally Query Protocol from SQL databases.",
  "license": "MIT",
  "author": "Mohamed Ashraf <cupo.ashraf@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohmmedAshraf/tally.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/MohmmedAshraf/tally",
  "bugs": "https://github.com/MohmmedAshraf/tally/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --coverage.enabled=false",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "kysely": "catalog:",
    "mysql2": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "12 kB",
      "ignore": [
        "tally-core",
        "tally-protocol",
        "kysely"
      ]
    }
  ],
  "dependencies": {
    "tally-core": "workspace:*",
    "tally-protocol": "workspace:*"
  },
  "peerDependencies": {
    "kysely": ">=0.29"
  }
}
