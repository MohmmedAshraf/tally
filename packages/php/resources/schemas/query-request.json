{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "filter": {
      "$ref": "#/$defs/Filter"
    },
    "sort": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sort"
      }
    },
    "group": {
      "$ref": "#/$defs/Group"
    },
    "page": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "offset",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cursor": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1
          },
          "fn": {
            "type": "string",
            "enum": [
              "sum",
              "avg",
              "min",
              "max",
              "count",
              "distinct"
            ]
          }
        },
        "required": [
          "column",
          "fn"
        ],
        "additionalProperties": false
      }
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "sort"
  ],
  "additionalProperties": false,
  "$defs": {
    "Filter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "and"
            },
            "filters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Filter"
              }
            }
          },
          "required": [
            "type",
            "filters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "or"
            },
            "filters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Filter"
              }
            }
          },
          "required": [
            "type",
            "filters"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not"
            },
            "filter": {
              "$ref": "#/$defs/Filter"
            }
          },
          "required": [
            "type",
            "filter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "condition"
            },
            "column": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "lt",
                "lte",
                "gt",
                "gte",
                "between",
                "contains",
                "notContains",
                "startsWith",
                "endsWith",
                "in",
                "notIn",
                "empty",
                "notEmpty",
                "within"
              ]
            },
            "value": {}
          },
          "required": [
            "type",
            "column",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "search"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "flag"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Sort": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "required": [
        "column",
        "direction"
      ],
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "granularity": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ]
        }
      },
      "required": [
        "column"
      ],
      "additionalProperties": false
    }
  }
}
