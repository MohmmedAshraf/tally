{
  "name": "tally-adapters",
  "version": "0.1.1",
  "description": "Client data sources for Tally: HTTP, TanStack Query, TanStack DB and Supabase.",
  "license": "MIT",
  "author": "Mohamed Ashraf <cupo.ashraf@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohmmedAshraf/tally.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/MohmmedAshraf/tally",
  "bugs": "https://github.com/MohmmedAshraf/tally/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "default": "./dist/supabase.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --coverage.enabled=false",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "size": "size-limit",
    "test:supabase": "TALLY_SUPABASE_URL=http://127.0.0.1:56321 vitest run src/supabase --coverage.enabled=false"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/db": "catalog:",
    "@tanstack/query-core": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tally-server": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6 kB",
      "ignore": [
        "@tanstack/db",
        "@tanstack/query-core",
        "eventsource",
        "tally-core",
        "tally-protocol",
        "zod",
        "@supabase/supabase-js"
      ]
    },
    {
      "path": "dist/query.js",
      "limit": "2 kB",
      "ignore": [
        "@tanstack/db",
        "@tanstack/query-core",
        "eventsource",
        "tally-core",
        "tally-protocol",
        "zod",
        "@supabase/supabase-js"
      ]
    },
    {
      "path": "dist/db.js",
      "limit": "3 kB",
      "ignore": [
        "@tanstack/db",
        "@tanstack/query-core",
        "eventsource",
        "tally-core",
        "tally-protocol",
        "zod",
        "@supabase/supabase-js"
      ]
    },
    {
      "path": "dist/supabase.js",
      "limit": "5 kB",
      "ignore": [
        "@tanstack/db",
        "@tanstack/query-core",
        "eventsource",
        "tally-core",
        "tally-protocol",
        "zod",
        "@supabase/supabase-js"
      ]
    }
  ],
  "dependencies": {
    "eventsource": "catalog:",
    "tally-core": "workspace:*",
    "tally-protocol": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2",
    "@tanstack/db": ">=0.13",
    "@tanstack/query-core": ">=5"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "@tanstack/db": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    }
  }
}
