{
  "name": "tally-ai",
  "version": "0.1.1",
  "description": "Natural language to query and AI columns for Tally.",
  "license": "MIT",
  "author": "Mohamed Ashraf <cupo.ashraf@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohmmedAshraf/tally.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/MohmmedAshraf/tally",
  "bugs": "https://github.com/MohmmedAshraf/tally/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --coverage.enabled=false",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "size": "size-limit"
  },
  "dependencies": {
    "ai": "catalog:",
    "tally-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "name": "tally-ai",
      "path": "dist/index.js",
      "limit": "6 kB",
      "ignore": [
        "ai",
        "tally-core",
        "zod"
      ]
    }
  ]
}
